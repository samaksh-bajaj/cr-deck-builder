# Copy this file to `.env` and paste in your Clash Royale API key.
#
#   cp .env.example .env
#
# The key must have 45.79.218.79 (the RoyaleAPI proxy) as its allowed IP address,
# because all requests go through https://proxy.royaleapi.dev instead of talking
# to api.clashroyale.com directly.
#
# No quotes, no spaces around the "=".
CR_API_KEY=paste-your-key-here
